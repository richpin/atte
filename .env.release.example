# Apple settings are needed only for release:macos.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"
APPLE_TEAM_ID=TEAM_ID
ATTE_NOTARY_PROFILE=atte-notary

# Both macOS and Windows releases require this updater key pair.
# Generate once with: pnpm tauri signer generate -w ~/.tauri/atte.key
ATTE_UPDATER_PUBLIC_KEY_PATH=/Users/your-name/.tauri/atte.key.pub
TAURI_SIGNING_PRIVATE_KEY=/Users/your-name/.tauri/atte.key
# Set in your shell or this ignored local env file if the key has a password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
